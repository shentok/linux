{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
          "label": "Build",
          "type": "shell",
          "command": "make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j $(nproc) Image dtbs",
          "problemMatcher": {
            "base": "$gcc",
            "fileLocation": ["relative", "${workspaceFolder}"]
          },
          "group": {
              "kind": "build",
              "isDefault": true
          }
        },
        {
          "label": "Run QEMU",
          "type": "shell",
          "command": "echo 'QEMU RTOSdemo started'; qemu-system-aarch64 -M imx8mp-evk -m 8G -kernel ${workspaceFolder}/arch/arm64/boot/Image -dtb ${workspaceFolder}/arch/arm64/boot/dts/freescale/imx8mp-evk.dtb -serial none -serial vc -append \"root=/dev/mmcblk1p2 loglevel=8 dyndbg=\\\"file *____* +p\\\"\" -drive file=/home/arch/Documents/ArchLinuxARM-aarch64/sdcard.img,if=sd,format=raw,bus=1 -netdev user,id=net0 -net nic,model=imx.enet,netdev=net0 -s -S",
          "dependsOn": ["Build"],
          "isBackground": true,
          "problemMatcher": [
            {
              "pattern": [
                {
                  "regexp": ".",
                  "file": 1,
                  "location": 2,
                  "message": 3
                }
              ],
              "background": {
                "activeOnStart": true,
                "beginsPattern": ".",
                "endsPattern": "QEMU RTOSdemo started",
              }
            }
          ]
        }
    ]
}
