{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
          "label": "Build",
          "type": "shell",
          "command": "make ARCH=arm CROSS_COMPILE=arm-none-eabi- -j $(nproc)",
          "problemMatcher": {
            "base": "$gcc",
            "fileLocation": ["relative", "${workspaceFolder}"]
          },
          "group": {
              "kind": "build",
              "isDefault": true
          }
        },
        {
          "label": "Run QEMU",
          "type": "shell",
          "command": "echo 'QEMU RTOSdemo started'; ~/Projekte/qemu/build-full/qemu-system-arm -M mcimx7d-sabre -kernel ${workspaceFolder}/arch/arm/boot/zImage -dtb ${workspaceFolder}/arch/arm/boot/dts/nxp/imx/imx7d-sdb.dtb -append \"root=/dev/mmcblk2p1\" -drive file=/home/shentey/Documents/imx7d-sdb/sdcard.img,if=none,format=raw,id=mmcblk2,snapshot=on -device sd-card,drive=mmcblk2 -drive if=none,id=usbstick,format=raw,file=/home/shentey/Documents/imx7d-sdb/rootfs.ext2,snapshot=on -device usb-storage,drive=usbstick,bus=usb-bus.0 -S -s",
          "dependsOn": ["Build"],
          "isBackground": true,
          "problemMatcher": [
            {
              "pattern": [
                {
                  "regexp": ".",
                  "file": 1,
                  "location": 2,
                  "message": 3
                }
              ],
              "background": {
                "activeOnStart": true,
                "beginsPattern": ".",
                "endsPattern": "QEMU RTOSdemo started",
              }
            }
          ]
        }
    ]
}
