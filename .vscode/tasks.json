{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
          "label": "Build",
          "type": "shell",
          "command": "make ARCH=arm CROSS_COMPILE=arm-none-eabi- -j $(nproc)",
          "problemMatcher": {
            "base": "$gcc",
            "fileLocation": ["relative", "${workspaceFolder}"]
          },
          "group": {
              "kind": "build",
              "isDefault": true
          }
        },
        {
          "label": "Run QEMU",
          "type": "shell",
          "command": "echo 'QEMU RTOSdemo started'; ~/Projects/qemu/build-full/qemu-system-aarch64 -M imx25-pdk -m 512M -kernel ${workspaceFolder}/arch/arm/boot/zImage -initrd /home/arch/Projects/buildroot/src/output/images/rootfs.cpio -dtb ${workspaceFolder}/arch/arm/boot/dts/nxp/imx/imx25-pdk.dtb -append \"root=/dev/ram loglevel=8 dyndbg=\\\"file *____* +p\\\"\" -trace imx_serial_* -s -S",
          "dependsOn": ["Build"],
          "isBackground": true,
          "problemMatcher": [
            {
              "pattern": [
                {
                  "regexp": ".",
                  "file": 1,
                  "location": 2,
                  "message": 3
                }
              ],
              "background": {
                "activeOnStart": true,
                "beginsPattern": ".",
                "endsPattern": "QEMU RTOSdemo started",
              }
            }
          ]
        }
    ]
}
